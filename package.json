  "type": "module",
  "scripts": {
    "dev": "pnpm --filter @nse/api dev",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/app.js",
    "fetch:board": "tsx scripts/fetch-board.ts > fixtures/board.json",
    "seed": "pnpm --filter @nse/db seed",
    "seed:fundamentals": "pnpm --filter @nse/db seed:fundamentals",
    "seed:corporate-actions": "pnpm --filter @nse/db seed:corporate-actions",
    "generate": "pnpm --filter @nse/db generate",
    "migrate:dev": "pnpm --filter @nse/db migrate:dev",
    "migrate:deploy": "pnpm --filter @nse/db migrate:deploy",
    "studio": "pnpm --filter @nse/db studio"
  },
  "dependencies": {
    "@prisma/client": "^6.1.0",
    "@nse/lib": "workspace:*",
    "dotenv": "^17.4.2",
    "express": "^4.21.0",
    "node-cron": "^3.0.3"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.0",
    "@types/node-cron": "^3.0.11",
    "prisma": "6.19.3",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  }
}